# Copy this file to `keystore.properties` (same directory, git-ignored) and fill in your own values.
#
# `storeFile` may be absolute, or relative to the repository root. Keeping the keystore OUTSIDE the
# repository is the recommended setup: a keystore inside a checkout is one careless `git add -A`
# away from being published, and anyone who obtains it can ship updates as you.
#
# Create a keystore with:
#
#   keytool -genkeypair -v \
#     -keystore /path/outside/the/repo/mynote-release.jks \
#     -alias mynote -keyalg RSA -keysize 4096 -validity 10000 \
#     -storetype PKCS12
#
# `keytool` prompts for both passwords; with PKCS12 they must be the same.

storeFile=/absolute/path/outside/the/repo/mynote-release.jks
storePassword=change-me
keyAlias=mynote
keyPassword=change-me
